# GTA 6 Shorts Factory · local configuration example
# Copy to .env (ignored by git) or export these before launching.

# ---------------------------------------------------------------- identity
COMPANY_NAME=GTA 6 Shorts Factory
# Optional local API protection. Leave empty for single-user localhost.
# FOUNDER_TOKEN=

# ------------------------------------------------------------- local storage
GTA_DATA_DIR=data
# GTA_DATABASE_PATH=data/factory.db
MAX_UPLOAD_MB=512
GTA_AUTO_SEED=true
LOCAL_PROCESSING_ENABLED=true

# -------------------------------------------------------------- media limits
MIN_CLIP_SECONDS=1
MAX_CLIP_SECONDS=90
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
MAX_RENDER_SECONDS=60
# Optional local Whisper model (requires faster-whisper or whisper installed)
WHISPER_MODEL=base

# ------------------------------------------------------- Everygen (optional)
EVERYGEN_ENABLED=false
EVERYGEN_MOCK=true
EVERYGEN_BUDGET_USD=25
EVERYGEN_CREDIT_USD=0.05
# Do not set until the official contract has been verified and a live adapter exists.
# EVERYGEN_LIVE_URL=

# ------------------------------------------------------------ MCP (optional)
# Live MCP transport is not implemented in this build. Keep false.
MCP_LIVE_ENABLED=false

# ------------------------------------------------------------ CUA (optional)
CUA_ENABLED=false
CUA_ALLOWED_DOMAINS=youtube.com,studio.youtube.com,tiktok.com,www.tiktok.com,everygen.ai,localhost,127.0.0.1,example.com
CUA_SESSION_MINUTES=30
CUA_MAX_ACTIONS=25

# The pipeline uses the same Cua VM as v2-automation. These paths are inside
# the guest, not on the host.
CUA_SANDBOX_NAME=dev
CUA_KIND=vm
# CUA_CLI=
# CUA_IMAGE=
CUA_GUEST_PROFILE=/home/cua/.config/mozilla/firefox/5s77mr7y.default-release
CUA_GUEST_VENV=/home/cua/venv/bin/python3
CUA_GUEST_MEDIA_DIR=/home/cua/media
CUA_GUEST_RUN_DIR=/home/cua/gta_pipeline
CUA_GUEST_DOWNLOAD_DIR=/home/cua/Downloads/everygen
CUA_GUEST_DISPLAY=:1

# --------------------------------------------------- CUA shorts pipeline
# The pipeline keeps its own SQLite db so it never fights factory.db.
GTA_PIPELINE_DATA_DIR=data/pipeline
# GTA_PIPELINE_DB=data/pipeline/pipeline.db

# generate = Everygen AI clips (paid); clip = local YouTube highlight
# clipping with yt-dlp + FFmpeg (free, no watermark).
PIPELINE_MODE=clip
# Required for clip mode: only clip sources you own or have permission to use.
PIPELINE_RIGHTS_ACK=false

# ------------------------------------------------------ local clip mode
PIPELINE_CLIPS_PER_VIDEO=2
PIPELINE_CLIP_MIN_SECONDS=15
PIPELINE_CLIP_MAX_SECONDS=60
PIPELINE_CLIP_TARGET_SECONDS=35
PIPELINE_CLIP_QUALITY=1080
PIPELINE_CLIP_LAYOUT=streamer
PIPELINE_CLIP_FACECAM_CROP=0.80,0.00,1.00,0.30
PIPELINE_CLIP_FACECAM_WIDTH=280
PIPELINE_CLIP_FACECAM_MARGIN=36
PIPELINE_CLIP_CAPTION_SIZE=12
PIPELINE_CLIP_CAPTION_MARGIN=24
PIPELINE_CLIP_CAPTION_FIXES=Viciti=Vice City
PIPELINE_CLIP_SHOW_TITLE=false
PIPELINE_CLIP_SHOW_CAPTIONS=true
PIPELINE_CLIP_TRANSCRIBE_FALLBACK=true
PIPELINE_WHISPER_PYTHON=/home/zenda/v2-automation/venv/bin/python
PIPELINE_WHISPER_MODEL=base
PIPELINE_WHISPER_TIMEOUT=900
PIPELINE_CLIP_MAX_SOURCE_SECONDS=7200
PIPELINE_CLIP_MAX_FULL_DOWNLOAD_SECONDS=900
PIPELINE_CLIP_DOWNLOAD_TIMEOUT=1200
PIPELINE_CLIP_RENDER_TIMEOUT=600
PIPELINE_CLIP_SUBTITLE_LANGS=en.*,en
PIPELINE_CLIP_TITLE_PREFIX=Streamer Moment | GTA 6
# PIPELINE_YTDLP_BIN=

# YouTube discovery (public search page, no API key)
PIPELINE_QUERIES=gta 6 trailer,gta 6 gameplay,gta 6 news,gta 6 secrets,gta 6 shorts
PIPELINE_RESULTS_PER_QUERY=20
PIPELINE_LINKS_PER_CYCLE=3
PIPELINE_MIN_VIEWS=0
PIPELINE_SEARCH_TIMEOUT=25

# Everygen Shorts Studio (driven through the signed-in CUA browser)
EVERYGEN_URL=https://everygen.ai/tools/shorts-studio
EVERYGEN_FORMAT=GTA 6
EVERYGEN_MODEL=Seedance 2.5
EVERYGEN_QUALITY=720p
EVERYGEN_DURATION=10s
EVERYGEN_CREDIT_BUDGET=200
EVERYGEN_ESTIMATED_CREDITS=39
EVERYGEN_TIMEOUT=1800
EVERYGEN_AUTO_APPROVE=true

# Variants/shorts and platform publishing
PIPELINE_VARIANTS_PER_LINK=2
PIPELINE_MAX_SHORTS_PER_CYCLE=4
PIPELINE_PLATFORMS=youtube,tiktok
PIPELINE_LIVE=false
PIPELINE_DAILY_LIMIT_YOUTUBE=3
PIPELINE_DAILY_LIMIT_TIKTOK=3
PIPELINE_YOUTUBE_HASHTAGS=#GTA6 #GTA #Shorts #Gaming
PIPELINE_TIKTOK_HASHTAGS=#gta6 #gta #shorts #gaming #fyp
PIPELINE_PUBLISH_TIMEOUT=1500
PIPELINE_REQUIRE_AUTH_CHECK=true
PIPELINE_RESPECT_EMERGENCY_STOP=true
PIPELINE_RETRY_LIMIT=2

# ------------------------------------------------------ publishing (dry run)
PUBLISHING_ENABLED=false
PUBLISHING_DRY_RUN=true
